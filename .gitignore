# Dependencies
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Audit logs (local runtime)
audit_logs/

# IDE / OS
.DS_Store
.vscode/
.idea/

# Internal docs (not for public repo)
docs/HANDOVER.md
docs/SRD-001-NEURALGUARD.md
docs/PHASE2-PLAN.md

# Audit artifacts (internal — regenerated per session)
AUDIT_HANDOFF.md
BUG_CATALOG.md
PRODUCTION_HARDENING_PLAN.md

# cosign local signing output (regenerated per session; bundles are session
# artifacts, CI re-signs keylessly — never commit signature bundles)
dist-sign/

# SBOM output (regenerated in CI)
sbom.json
sbom.xml

# uv lock (optional — commit if you want reproducible CI)
# uv.lock

# ONNX model files (large binaries — export locally)
models/embedding-onnx/*.onnx
# 16 MB and regenerated by scripts/export_onnx.py on every build; the model
# declaration that must stay tracked is config.json.
models/embedding-onnx/tokenizer.json
models/embedding-onnx/*.bin
models/embedding-onnx/special_tokens_map.json
models/embedding-onnx/tokenizer_config.json
models/embedding-onnx/vocab.txt
!models/.gitkeep

# Pre-computed attack vectors (regenerated from datasets)
models/attack_vectors.npy
models/attack_metadata.json
models/augment_checkpoint.jsonl
models/augment_run.log
# Per-tenant override files (Sprint C, C1). The sample example.yaml is
# tracked as a reference; real tenant files must NOT be committed (they may
# carry tenant identifiers / quota policy an operator does not want public).
tenants/*.yaml
tenants/*.yml
tenants/*.json
!tenants/example.yaml

# Internal research ledgers are machine-local working documents (same policy as
# PRODUCTION_HARDENING_PLAN.md); durable conclusions graduate into tracked docs.
docs/RESEARCH_FRONTIER_2026.md

# local dev secrets — never commit
.env
# Filled manifests generated from the templates in deploy/ (the .example is the
# tracked one). Nothing prevented `git add -A` from committing a live password.
deploy/kubernetes/secret.yaml
deploy/kubernetes/*secret*.yaml
!deploy/kubernetes/secret.example.yaml

# F18: live benchmark run artifacts are machine-local; the curated records in this
# directory ARE tracked — they are the provenance the README cites — so the rule
# below is an explicit ignore/enumerate split rather than a blanket directory rule.
# A tracked file with no `!` negation here is a contradiction that only survives
# because git was told force-add once; tests/unit/test_benchmark_provenance.py
# fails when that happens (`git check-ignore --no-index`).
benchmarks/ng_vs_ns/results/*
!benchmarks/ng_vs_ns/results/A2_RESULTS.md
!benchmarks/ng_vs_ns/results/B4_RESULTS.md
!benchmarks/ng_vs_ns/results/a2_results.json
!benchmarks/ng_vs_ns/results/known_gaps.md
# b4_results.json stays untracked on purpose: B4_RESULTS.md transcribes its
# numbers, and the raw run output is a machine-local artifact, not evidence.
