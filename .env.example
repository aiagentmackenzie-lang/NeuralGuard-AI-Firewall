# NeuralGuard configuration. Copy to `.env` and edit.
# In production, NEVER commit real secrets. Use a secret manager (SOPS, Vault,
# AWS Secrets Manager) and inject these at runtime.

# ── General ─────────────────────────────────────────────────────────────
NEURALGUARD_ENVIRONMENT=production
NEURALGUARD_DEBUG=false
NEURALGUARD_LOG_LEVEL=INFO

# ── Server ──────────────────────────────────────────────────────────────
NEURALGUARD_SERVER_HOST=0.0.0.0
NEURALGUARD_SERVER_PORT=8000
NEURALGUARD_SERVER_WORKERS=1
# Hard cap on request body size (bytes). Default 1 MiB.
NEURALGUARD_SERVER_MAX_REQUEST_BODY_BYTES=1048576
# CORS: explicit allowlist. Empty = no CORS (API-only). NEVER combine ["*"]
# with allow_credentials=true.
NEURALGUARD_SERVER_CORS_ORIGINS=["https://app.example.com"]
NEURALGUARD_SERVER_ALLOW_CREDENTIALS=false
# Set to true ONLY if a TLS-terminating reverse proxy is in front of NeuralGuard.
# Otherwise the production startup fails-fast to prevent serving prompts over HTTP.
NEURALGUARD_SERVER_ALLOW_INSECURE_HTTP=false

# ── Authentication (REQUIRED in production) ──────────────────────────────
# Enable API-key auth. The app refuses to start in production unless enabled
# with at least one key.
NEURALGUARD_AUTH_ENABLED=true
# Comma-separated keys. Format: "key" (tenant=default) or "key|tenant_id".
# Generate strong keys, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`.
NEURALGUARD_AUTH_API_KEYS=replace-me-with-a-strong-key|demo
NEURALGUARD_AUTH_ENFORCE_TENANT_FROM_KEY=true

# ── Scanner ─────────────────────────────────────────────────────────────
NEURALGUARD_SCANNER_SEMANTIC_ENABLED=false
NEURALGUARD_SCANNER_JUDGE_ENABLED=false
# When judge is enabled, point this at a LOCAL Ollama (loopback) to keep
# prompts from leaving the trust boundary.
NEURALGUARD_SCANNER_JUDGE_MODEL=qwen2.5:1.5b

# ── Actions ─────────────────────────────────────────────────────────────
NEURALGUARD_ACTION_FAIL_CLOSED=true
NEURALGUARD_ACTION_ENABLE_ESCALATION=false
# NEURALGUARD_ACTION_ESCALATION_WEBHOOK_URL=

# ── Audit ───────────────────────────────────────────────────────────────
NEURALGUARD_AUDIT_ENABLED=true
NEURALGUARD_AUDIT_BACKEND=jsonl
NEURALGUARD_AUDIT_JSONL_PATH=/data/audit
NEURALGUARD_AUDIT_RETENTION_DAYS=30
NEURALGUARD_AUDIT_TOKENIZE_PII=true
# Postgres URL (if backend=postgres). Use a strong, rotated password.
# NEURALGUARD_AUDIT_POSTGRES_URL=postgresql+asyncpg://neuralguard:STRONG_PASSWORD@postgres:5432/neuralguard

# ── Rate limiting ───────────────────────────────────────────────────────
NEURALGUARD_RATELIMIT_ENABLED=true
NEURALGUARD_RATELIMIT_REQUESTS_PER_MINUTE=60
NEURALGUARD_RATELIMIT_BURST_SIZE=10
# Backend: 'memory' (per-process, single-worker only) or 'redis' (shared
# across workers — required when NEURALGUARD_SERVER_WORKERS>1 in production).
NEURALGUARD_RATELIMIT_BACKEND=memory
# NEURALGUARD_RATELIMIT_REDIS_URL=redis://localhost:6379/0

# ── Agent Guardian (multi-turn detection, Phase 3 Sprint B) ─────────────
# Disabled by default. When enabled, keeps a bounded per-session sliding
# window of turns to detect delayed injection, role drift, and accumulation
# attacks across turns. Provide a session_id on /v1/evaluate to correlate.
NEURALGUARD_AGENT_GUARDIAN_ENABLED=false
NEURALGUARD_AGENT_GUARDIAN_SESSION_WINDOW_TURNS=10
NEURALGUARD_AGENT_GUARDIAN_BACKEND=memory
# NEURALGUARD_AGENT_GUARDIAN_REDIS_URL=redis://localhost:6379/0
# NEURALGUARD_AGENT_GUARDIAN_ROLE_DRIFT_THRESHOLD=2
# NEURALGUARD_AGENT_GUARDIAN_EXTRACTION_PROBE_THRESHOLD=3
# NEURALGUARD_AGENT_GUARDIAN_MEMORY_INJECTION_THRESHOLD=2
# Required when backend=redis. No default is provided intentionally.
# NEURALGUARD_RATELIMIT_REDIS_URL=redis://redis:6379/0

# ── Readiness probe (P1-3) ───────────────────────────────────────────────
# /v1/ready is auth-protected by default. Add it here for an unauthenticated
# kubelet readiness probe (the response carries only coarse status strings,
# no secrets/URLs).
# NEURALGUARD_AUTH_PUBLIC_ENDPOINTS=["/v1/health","/v1/ready"]

# ── Postgres (docker-compose only) ──────────────────────────────────────
# MUST be set in production. No default is provided intentionally.
POSTGRES_PASSWORD=change-me-to-a-strong-password
NEURALGUARD_PORT=8000