# NeuralGuard configuration. Copy to `.env` and edit.
# In production, NEVER commit real secrets. Use a secret manager (SOPS, Vault,
# AWS Secrets Manager) and inject these at runtime.
#
# EVERY key below maps to a real settings field. Any NEURALGUARD_* key that
# maps to no field is a silent no-op — production startup REFUSES on unknown
# keys (dev logs a loud warning). Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── General ─────────────────────────────────────────────────────────────
NEURALGUARD_ENVIRONMENT=production
NEURALGUARD_DEBUG=false
NEURALGUARD_LOG_LEVEL=INFO

# ── Server ──────────────────────────────────────────────────────────────
NEURALGUARD_HOST=0.0.0.0
NEURALGUARD_PORT=8000
NEURALGUARD_WORKERS=1
# Hard cap on request body size (bytes). Default 1 MiB.
NEURALGUARD_MAX_REQUEST_BODY_BYTES=1048576
# CORS: explicit allowlist. Empty = no CORS (API-only). NEVER combine ["*"]
# with allow_credentials=true.
NEURALGUARD_CORS_ORIGINS=["https://app.example.com"]
NEURALGUARD_ALLOW_CREDENTIALS=false
# Set to true ONLY if a TLS-terminating reverse proxy is in front of NeuralGuard.
# Otherwise production logs a loud TLS notice on every boot.
NEURALGUARD_ALLOW_INSECURE_HTTP=false

# ── Authentication (REQUIRED in production) ──────────────────────────────
# The app refuses to start in production unless enabled with at least one key.
NEURALGUARD_AUTH_ENABLED=true
# Comma-separated keys. Format: "key" (tenant=default) or "key|tenant_id".
NEURALGUARD_AUTH_API_KEYS=replace-me-with-a-strong-key|demo
NEURALGUARD_AUTH_ENFORCE_TENANT_FROM_KEY=true

# ── JWT bearer auth + runtime key rotation (P2-4) ────────────────────────
# Short-lived JWTs issued by POST /v1/auth/token in exchange for a valid
# credential (HS256, alg allowlist, exp enforced). Secret >= 32 chars REQUIRED
# when enabled (validator refuses otherwise).
# NEURALGUARD_AUTH_JWT_ENABLED=false
# NEURALGUARD_AUTH_JWT_SECRET=replace-me-with-a-generated-32-plus-char-secret
# NEURALGUARD_AUTH_JWT_TTL_MINUTES=15
# Tenant whose keys/tokens may call POST /v1/auth/keys/rotate (admin-only).
# NEURALGUARD_AUTH_ADMIN_TENANT=admin
# Runtime key store (JSON) for DURABLE rotation (atomic 0600 writes). Without
# it, rotation is runtime-only and REFUSED in production.
# NEURALGUARD_AUTH_KEYS_FILE=/data/auth_keys.json

# ── Scanner: pattern layer ──────────────────────────────────────────────
# Per-pattern ReDoS timeout (ms) and per-text aggregate deadline. Beyond the
# budget, remaining patterns are SKIPPED and a PATTERN-BUDGET escalate finding
# is emitted (fail toward review, never silently weaker). Default 300.
# NEURALGUARD_SCANNER_REGEX_TIMEOUT_MS=50
# NEURALGUARD_SCANNER_PATTERN_BUDGET_MS=300
# NEURALGUARD_SCANNER_MAX_INPUT_LENGTH=32000
# NEURALGUARD_SCANNER_MAX_DECOMPRESSION_RATIO=10.0
# NEURALGUARD_SCANNER_MAX_REGEX_COMPLEXITY=20

# ── Scanner: semantic layer (Phase 2; needs the [semantic] extra + model) ─
NEURALGUARD_SCANNER_SEMANTIC_ENABLED=false
# NEURALGUARD_SCANNER_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# NEURALGUARD_SCANNER_SEMANTIC_ONNX_PATH=models/embedding-onnx
# NEURALGUARD_SCANNER_SEMANTIC_ATTACK_CORPUS_PATH=models/attack_vectors.npy
# NEURALGUARD_SCANNER_SEMANTIC_ATTACK_METADATA_PATH=models/attack_metadata.json
# NEURALGUARD_SCANNER_SEMANTIC_SIMILARITY_THRESHOLD=0.75
# NEURALGUARD_SCANNER_SEMANTIC_MAX_SEQ_LENGTH=256
# NEURALGUARD_SCANNER_SEMANTIC_INTRA_THREADS=0
# NG-4 overflow-resistant windowed aggregation (Prompt Overflow defense,
# arXiv:2605.23196): for long inputs the semantic layer additionally embeds
# overlapping windows and flags accumulated sub-threshold risk across
# contiguous windows. Tune only with A1/A2 measurement.
# NEURALGUARD_SCANNER_SEMANTIC_OVERFLOW_DETECTION=true
# NEURALGUARD_SCANNER_SEMANTIC_OVERFLOW_WINDOW_CHARS=400
# NEURALGUARD_SCANNER_SEMANTIC_OVERFLOW_MAX_WINDOWS=12
# NEURALGUARD_SCANNER_SEMANTIC_OVERFLOW_BENIGN_THRESHOLD=0.60
# NEURALGUARD_SCANNER_SEMANTIC_OVERFLOW_DECISION_THRESHOLD=0.30
# NEURALGUARD_SCANNER_SEMANTIC_OVERFLOW_MIN_RUN=2
# NG-6 published FPR SLO: the guarded false-positive rate (share of guard
# probes whose worst corpus match reaches the BLOCK threshold) is measured
# at boot against the benign corpus + the benign look-alike hard negatives,
# logged loudly, and surfaced on /v1/info. Measured on the rebuilt corpus
# (2026-09-07): 0.00% across 95 probes — see docs/FPR_SLO.md.
# NEURALGUARD_SCANNER_SEMANTIC_FPR_SLO=2.0
# Opt-in boot enforcement: fail startup when the measured guarded FPR
# exceeds the SLO. Default false — an SLO breach is a quality failure, not
# a safety failure.
# NEURALGUARD_SCANNER_SEMANTIC_FPR_SLO_ENFORCE=false
# Guard probe files (JSONL, {id, prompt, category} rows).
# NEURALGUARD_SCANNER_SEMANTIC_BENIGN_GUARD_PATH=benchmarks/ng_vs_ns/benign_corpus.jsonl
# NEURALGUARD_SCANNER_SEMANTIC_HARD_NEGATIVES_PATH=corpus/benign_hard_negatives.jsonl

# ── Scanner: LLM-as-Judge (Phase 2; local Ollama) ───────────────────────
NEURALGUARD_SCANNER_JUDGE_ENABLED=false
# Judge model (Ollama tag). Default mistral:7b. The 27B qwen judge is a
# documented option (~20s/call on the reference box — raise the timeout).
NEURALGUARD_SCANNER_JUDGE_MODEL=mistral:7b
# Loopback/private by default in production: a non-private URL REFUSES to
# start unless JUDGE_ALLOW_EGRESS=true (explicit, logged, surfaced in /v1/ready).
NEURALGUARD_SCANNER_JUDGE_OLLAMA_URL=http://localhost:11434
# NEURALGUARD_SCANNER_JUDGE_TIMEOUT_SECONDS=5
# NEURALGUARD_SCANNER_JUDGE_MAX_TOKENS=512
# NEURALGUARD_SCANNER_JUDGE_TEMPERATURE=0.0
# NEURALGUARD_SCANNER_JUDGE_MAX_CONCURRENCY=4
# NEURALGUARD_SCANNER_JUDGE_ALLOW_EGRESS=false
# Opt-in (default false): a clean LLM-Judge ALLOW downgrades a hybrid ESCALATE
# to ALLOW. Drops semantic-layer FPR to 0% but, with a weak/local judge, also
# lets through real attacks the semantic layer caught when the judge
# false-negatives them. Measured-safe with a 27B judge (A2_RESULTS); enable
# ONLY with a judge you have measured. (The old NEURALGUARD_ACTION_ placement
# is dead — F20.)
# NEURALGUARD_SCANNER_JUDGE_RESOLVES_ESCALATE=false

# ── Actions ─────────────────────────────────────────────────────────────
NEURALGUARD_ACTION_FAIL_CLOSED=true
NEURALGUARD_ACTION_ENABLE_ESCALATION=false
# NEURALGUARD_ACTION_ESCALATION_WEBHOOK_URL=
# NEURALGUARD_ACTION_SCORE_THRESHOLD_BLOCK=0.85
# NEURALGUARD_ACTION_SCORE_THRESHOLD_SANITIZE=0.60
# Corroboration gate (default true): a lone ambiguous semantic match (similarity
# below the 0.75 BLOCK floor) produces ESCALATE, not SANITIZE — don't modify
# content on a single ambiguous signal. SANITIZE in the ambiguous zone requires
# pattern corroboration or semantic similarity at/above the BLOCK floor.
NEURALGUARD_ACTION_SEMANTIC_SANITIZE_REQUIRES_CORROBORATION=true

# ── Agent Guardian (multi-turn detection, Phase 3) ──────────────────────
# Keeps a bounded per-session sliding window of per-turn signal flags (never
# raw turn text) to detect delayed injection, role drift, and accumulation
# attacks across turns. Send a session_id on /v1/evaluate to correlate.
NEURALGUARD_AGENT_GUARDIAN_ENABLED=false
# NEURALGUARD_AGENT_GUARDIAN_SESSION_WINDOW_TURNS=10
# Backend: 'memory' (per-process, single-worker only) or 'redis' (shared
# across workers — required for multi-worker production).
# NEURALGUARD_AGENT_GUARDIAN_BACKEND=memory
# NEURALGUARD_AGENT_GUARDIAN_REDIS_URL=redis://localhost:6379/1
# NEURALGUARD_AGENT_GUARDIAN_SESSION_TTL_SECONDS=1800
# NG-3 decode-then-activate (controlled-release shape): fires only when a
# decode/extraction step combines with a follow-the-decoded-content
# directive. Decoding alone stays ALLOWed (CTFs/students/i18n).
# NEURALGUARD_AGENT_GUARDIAN_DECODE_ACTIVATION_ENABLED=true
# NEURALGUARD_AGENT_GUARDIAN_ROLE_DRIFT_THRESHOLD=2
# NEURALGUARD_AGENT_GUARDIAN_EXTRACTION_PROBE_THRESHOLD=3
# NEURALGUARD_AGENT_GUARDIAN_MEMORY_INJECTION_THRESHOLD=2
# NEURALGUARD_AGENT_GUARDIAN_MAX_SESSIONS=10000

# ── Canary token verification (Phase 3, B3) ─────────────────────────────
# HMAC-SHA256 exfiltration signal: mint per-session tokens (`NGCANARY-...`),
# inject into the system prompt, detect in /v1/scan/output as a HIGH/BLOCK
# SYSTEM_PROMPT_EXTRACTION finding. Deterministic — no server-side store.
# In production the secret MUST be set and >= 32 chars (lifespan-enforced).
NEURALGUARD_CANARY_ENABLED=false
# NEURALGUARD_CANARY_SECRET=replace-me-with-a-high-entropy-secret-at-least-32-characters-long
# NEURALGUARD_CANARY_TOKEN_COUNT=4

# ── Rate limiting ───────────────────────────────────────────────────────
NEURALGUARD_RATELIMIT_ENABLED=true
NEURALGUARD_RATELIMIT_REQUESTS_PER_MINUTE=60
NEURALGUARD_RATELIMIT_BURST_SIZE=10
# Backend: 'memory' (per-process, single-worker only) or 'redis' (shared
# across workers — required when NEURALGUARD_WORKERS>1 in production).
NEURALGUARD_RATELIMIT_BACKEND=memory
# NEURALGUARD_RATELIMIT_REDIS_URL=redis://localhost:6379/0
# Cost-based mode (T-DOS cost-abuse control): limit by estimated LLM cost
# (request bytes / 4 ~ tokens) instead of request count. In cost mode the
# window budget is cost_units_per_minute and burst_size does not apply.
# NEURALGUARD_RATELIMIT_COST_BASED=false
# NEURALGUARD_RATELIMIT_COST_UNITS_PER_MINUTE=100000

# ── Per-tenant config (Sprint C, C1 / P1-2) ──────────────────────────────
# Loads tenants/*.yaml|json override files and applies them on top of the
# global config at request time (per-tenant RPM/burst + per-tenant enable/
# disable for the optional scanners). Structural + Pattern are mandatory and
# cannot be disabled per-tenant. Unknown-tenant miss is fail-OPEN to global.
# YAML tenant files require the [tenants] extra (PyYAML); .json needs no extra.
NEURALGUARD_TENANT_ENABLED=false
NEURALGUARD_TENANT_CONFIG_PATH=./tenants
NEURALGUARD_TENANT_DEFAULT_TENANT=default
# Background hot-reload poll interval (seconds). 0 disables hot-reload.
NEURALGUARD_TENANT_RELOAD_INTERVAL_SECONDS=30

# ── Standalone appliance proxy (F9) ─────────────────────────────────────
# OFF by default. Enabling turns NeuralGuard into a transparent guardian:
# POST /v1/proxy/chat/completions evaluates user turns, forwards ALLOWed
# requests to the OpenAI-compatible upstream (Ollama /v1, vLLM, cloud), and
# scans the completion (PII/exfil/canary) before delivery. Streaming is
# refused 422 (fail-closed). The upstream key is server-side, never logged.
# NEURALGUARD_PROXY_ENABLED=false
# NEURALGUARD_PROXY_UPSTREAM_URL=http://localhost:11434/v1
# NEURALGUARD_PROXY_UPSTREAM_API_KEY=
# NEURALGUARD_PROXY_TIMEOUT_SECONDS=120
# NG-1: opt-in scan of the upstream's reasoning/thinking tokens with the
# same output semantics + canary detection. Thinking models can emit the
# payload as intermediate output even when the final answer is clean
# (USENIX Security 2026). Fail-closed: a reasoning payload that is present
# but not a scannable string BLOCKS the response.
# NEURALGUARD_PROXY_OUTPUT_REASONING_SCAN=false

# ── SIEM routing + BLOCK-rate spike alerting (P2-7) ─────────────────────
# Best-effort observability: delivery failures never affect verdicts. At
# least one sink is REQUIRED when enabled (production refuses otherwise).
# Splunk HEC (native):
# NEURALGUARD_SIEM_ENABLED=false
# NEURALGUARD_SIEM_SPLUNK_HEC_URL=https://splunk.example.com:8088
# NEURALGUARD_SIEM_SPLUNK_HEC_TOKEN=
# NEURALGUARD_SIEM_SPLUNK_SOURCE_TYPE=neuralguard:verdict
# Generic JSON webhook (ELK webhook input / Sentinel Logic App / any collector):
# NEURALGUARD_SIEM_WEBHOOK_URL=
# NEURALGUARD_SIEM_WEBHOOK_TOKEN=
# SecurityScarletAI (local AI-native SIEM; ECS IngestEvent, correlations
# fire on arrival, ingest-only scoped token):
# NEURALGUARD_SIEM_SCARLETAI_URL=http://127.0.0.1:8000/api/v1/ingest
# NEURALGUARD_SIEM_SCARLETAI_TOKEN=
# NEURALGUARD_SIEM_SCARLETAI_HOST=
# NEURALGUARD_SIEM_SCARLETAI_ROUTE_ALLOW=false
# Delivery + spike-detector tuning:
# NEURALGUARD_SIEM_TIMEOUT_SECONDS=5.0
# NEURALGUARD_SIEM_MAX_INFLIGHT=20
# NEURALGUARD_SIEM_SPIKE_WINDOW=100
# NEURALGUARD_SIEM_SPIKE_BLOCK_THRESHOLD=0.5
# NEURALGUARD_SIEM_SPIKE_COOLDOWN_SECONDS=300

# ── Audit ───────────────────────────────────────────────────────────────
NEURALGUARD_AUDIT_ENABLED=true
NEURALGUARD_AUDIT_BACKEND=jsonl
NEURALGUARD_AUDIT_JSONL_PATH=/data/audit
NEURALGUARD_AUDIT_RETENTION_DAYS=30
NEURALGUARD_AUDIT_TOKENIZE_PII=true
# Max concurrent in-flight async Postgres writes per worker; beyond this,
# events fall back to JSONL (a slow DB must not OOM the worker).
# NEURALGUARD_AUDIT_MAX_INFLIGHT_WRITES=1000
# Ed25519 PRIVATE seed (hex, 32 bytes) for audit-event signing (P2-10). When
# set, every persisted event's chain hash is signed; verify with
# `neuralguard audit-verify --pubkey <hex>`. Generate: neuralguard audit-keygen.
# NEURALGUARD_AUDIT_SIGNING_KEY=
# Postgres URL (if backend=postgres). Use a strong, rotated password.
# NEURALGUARD_AUDIT_POSTGRES_URL=postgresql+asyncpg://neuralguard:STRONG_PASSWORD@postgres:5432/neuralguard

# ── Readiness probe (P1-3) ──────────────────────────────────────────────
# /v1/ready is auth-protected by default. Add it here for an unauthenticated
# kubelet readiness probe (the response carries only coarse status strings,
# no secrets/URLs).
# NEURALGUARD_AUTH_PUBLIC_ENDPOINTS=["/v1/health","/v1/ready"]

# ── docker-compose only ─────────────────────────────────────────────────
# MUST be set in production. No insecure default in docker-compose.yml.
POSTGRES_PASSWORD=change-me-to-a-strong-password
# ── MCP gateway (NG-7/NG-8) ────────────────────────────────────────────
# NeuralGuard as an MCP gateway: POST /v1/mcp — JSON-RPC passthrough to one
# MCP server (streamable-HTTP). The Intent Gate decides per-tool intent on
# the Mcp-Method/Mcp-Name headers BEFORE body parse; the baseliner refuses
# rug pulls (drifted tool catalogs) and never executes a tool the baseline
# never contained. See docs/runbooks/mcp_gateway.md.
# NEURALGUARD_MCP_ENABLED=false
# NEURALGUARD_MCP_UPSTREAM_URL=http://localhost:3000
# NEURALGUARD_MCP_TIMEOUT_SECONDS=30
# strict: catalog drift withholds the changed catalog and refuses tool calls
# until an explicit re-baseline. advisory: alert + pass (canary only).
# NEURALGUARD_MCP_MODE=strict
# NEURALGUARD_MCP_SERVER_ID=default
# Ed25519 seed (hex) to SIGN baselines (P2-10 crypto). Empty = unsigned.
# SERVER-SIDE SECRET — never logged; rotate via secret_rotation.md.
# NEURALGUARD_MCP_SIGNING_SEED=
# Ed25519 pubkey (hex) to VERIFY registry-signed catalog changes
# (X-MCP-Catalog-Signature recovery path). Empty = disabled.
# NEURALGUARD_MCP_VERIFY_PUBKEY=
# When true, drift resolves ONLY via a signature-verified change.
# NEURALGUARD_MCP_REQUIRE_SIGNATURE_ON_CHANGE=false
# The NG-8 seam: require Mcp-Method/Mcp-Name headers on every gateway POST.
# NEURALGUARD_MCP_HEADERS_REQUIRED=true
# NG-9: provenance-lite egress binding (opt-in). Tool-result content passing
# through the gateway taints the session window; tenant-classified egress
# tools get their arguments checked for tainted content BEFORE forwarding.
# off = control disabled | warn = alert + allow | block = refuse (fail-closed).
# NEURALGUARD_MCP_PROVENANCE_MODE=off
# NEURALGUARD_MCP_PROVENANCE_TTL_SECONDS=3600
# NEURALGUARD_MCP_PROVENANCE_MAX_SESSIONS=1000
# fail-closed edge: refuse egress calls with no Mcp-Session-Id when mode != off
# NEURALGUARD_MCP_PROVENANCE_REQUIRE_SESSION=false
