# Fleet deployment env template — copy to `.env` (SAME directory as
# docker-compose.fleet.yml) and fill every CHANGE_ME with generated secrets.
# Compose reads this `.env` because it sits next to the compose file; it
# feeds BOTH stacks (Scarlet's pins + NeuralGuard's fleet wiring).
#
# Generate secrets:
#   openssl rand -base64 32   # DB_PASSWORD, DB_READONLY_PASSWORD, MCP_BEARER_TOKEN
#   openssl rand -hex 32      # API_SECRET_KEY, API_BEARER_TOKEN, INGEST_BEARER_TOKEN,
#                             #   NEURALGUARD_CANARY_SECRET, NG API keys
#
# NEVER commit the filled .env.

# ── SecurityScarletAI (required by its compose pins) ──────────────────────
DB_PASSWORD=CHANGE_ME_openssl_rand_base64_32
API_SECRET_KEY=CHANGE_ME_openssl_rand_hex_64
API_BEARER_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Scoped READ-ONLY role password for Scarlet's MCP server process.
DB_READONLY_PASSWORD=CHANGE_ME_openssl_rand_base64_32
# Scarlet's MCP auth token — NeuralGuard's MCP gateway forwards it as
# 'Authorization: Bearer <token>' (NEURALGUARD_MCP_UPSTREAM_AUTH_TOKEN).
MCP_BEARER_TOKEN=CHANGE_ME_openssl_rand_base64_32
# Scoped ingest credential — SHARED: Scarlet verifies it on /api/v1/ingest,
# NeuralGuard sends it with every SIEM delivery (parent + companions).
INGEST_BEARER_TOKEN=CHANGE_ME_openssl_rand_hex_32
# Optional: static dashboard credential (else dashboard requires login).
DASHBOARD_API_TOKEN=
# Judge/LLM model tag for both stacks (host Ollama must have it pulled).
OLLAMA_MODEL=mistral:7b

# ── NeuralGuard (fleet posture) ───────────────────────────────────────────
# Host port for the fleet NeuralGuard (Scarlet publishes :8000).
NG_FLEET_PORT=8100
# Scarlet's MCP endpoint (the JSON-RPC route on its MCP server). The default
# matches Scarlet's POST /mcp on :8002 inside the compose network.
# NEURALGUARD_MCP_UPSTREAM_URL=http://mcp:8002/mcp
# Caller API keys, format "<key>|<tenant>" (comma-separated for several).
NEURALGUARD_AUTH_API_KEYS=CHANGE_ME_openssl_rand_hex_32|default
# Canary HMAC secret (>= 32 chars) for output-scan canary leak detection.
NEURALGUARD_CANARY_SECRET=CHANGE_ME_openssl_rand_hex_32
# SIEM host_name Scarlet sees for this firewall (optional override).
# NEURALGUARD_SIEM_SCARLETAI_HOST=neuralguard-fleet
# Host Ollama model + judge tuning (both stacks default mistral:7b).
# JUDGE_MODEL=mistral:7b
# JUDGE_TIMEOUT_SECONDS=10
# Proxy upstream (OpenAI-compatible; default = host Ollama).
# NEURALGUARD_PROXY_UPSTREAM_URL=http://host.docker.internal:11434/v1
# NEURALGUARD_PROXY_UPSTREAM_API_KEY=
# PROXY_ENABLED=true
# Rate limiting (memory backend, single worker).
# NEURALGUARD_RATELIMIT_REQUESTS_PER_MINUTE=60